{
  "name": "steakz-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\start-steakz.ps1",
    "dev:api": "nodemon --watch src --exec tsx src/index.ts",
    "build": "tsc --build",
    "start": "node dist/index.js",
    "db:seed": "tsx scripts/seed.ts",
    "test": "tsx --test src/middleware/auth.test.ts src/lib/bookingValidation.test.ts src/lib/dineInBooking.test.ts src/lib/deliveryWorkflow.test.ts src/lib/customerDashboard.test.ts src/lib/orderIdempotency.test.ts",
    "test:delivery-accounts": "node --test scripts/setup_presentation_delivery_accounts.test.cjs",
    "test:presentation-passwords": "node --test scripts/set_presentation_passwords.test.cjs",
    "test:e2e:delivery:sqlite": "node scripts/e2e_delivery_workflow_test.cjs",
    "setup:presentation:delivery": "node scripts/setup_presentation_delivery_accounts.cjs",
    "setup:presentation:passwords": "node scripts/set_presentation_passwords.cjs",
    "test:e2e:delivery": "node scripts/e2e_delivery_test.js",
    "test:e2e:branches": "node scripts/e2e_active_branches_test.js",
    "test:e2e:manager": "node scripts/e2e_multi_branch_manager_test.js",
    "test:e2e:isolation": "node scripts/e2e_branch_isolation_test.js",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
