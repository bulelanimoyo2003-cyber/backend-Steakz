# Local SQLite API configuration. Use a local-only database path.
DATABASE_URL="file:./path/to/local-only.db"
JWT_SECRET="replace-with-a-random-local-secret"
JWT_EXPIRES_IN="7d"
ADMIN_EMAIL="admin@steakz.com"
ADMIN_PASSWORD="change-this-local-password"
PORT=3001
FRONTEND_URL="http://localhost:5173"
CORS_ALLOWED_ORIGINS="https://your-production-frontend.example"
