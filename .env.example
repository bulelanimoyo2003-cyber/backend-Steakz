# Local SQLite API configuration. The path is relative to prisma/schema.prisma.
DATABASE_URL="file:../backend/prisma/dev.db"
JWT_SECRET="replace-with-a-random-local-secret"
JWT_EXPIRES_IN="7d"
ADMIN_EMAIL="admin@steakz.com"
ADMIN_PASSWORD="change-this-local-password"
PORT=3001
FRONTEND_URL="http://localhost:5173"
DINE_IN_BOOKING_EARLY_WINDOW_MINUTES=60
DINE_IN_BOOKING_DURATION_MINUTES=240
