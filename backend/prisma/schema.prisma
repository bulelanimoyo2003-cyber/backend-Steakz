generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}  
enum Role {
  ADMIN
  HQ_MANAGER
  BRANCH_MANAGER
  CHEF
  CASHIER
  CUSTOMER
  DELIVERY_DRIVER
}

enum OrderType {
  DINE_IN
  COLLECTION
  DELIVERY
}

enum DeliveryStatus {
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
}

enum OrderStatus {
  PENDING
  PREPARING
  DONE
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CASH
  STRIPE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  CLEANING
}

model Branch {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  address       String
  phone         String?
  isActive      Boolean        @default(true)
  users         User[]
  designatedDeliveryDriverId Int? @unique
  designatedDeliveryDriver User? @relation("BranchDesignatedDeliveryDriver", fields: [designatedDeliveryDriverId], references: [id], onDelete: SetNull)
  managerAssignments BranchManagerAssignment[]
  tables        Table[]
  menuItems     MenuItem[]
  orders        Order[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(CUSTOMER)
  isActive  Boolean   @default(true)
  branch     Branch?   @relation(fields: [branchId], references: [id])
  branchId  Int?
  managedBranches BranchManagerAssignment[]
  salary    Float?
  bookings  Booking[]
  orders    Order[]
  assignedDeliveries Order[] @relation("AssignedDeliveryDriver")
  designatedForDeliveryBranch Branch? @relation("BranchDesignatedDeliveryDriver")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model BranchManagerAssignment {
  userId   Int
  branchId Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, branchId])
  @@index([branchId])
}

model MenuItem {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  price       Float
  category    String
  isAvailable Boolean     @default(true)
  branch      Branch      @relation(fields: [branchId], references: [id])
  branchId    Int
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Table {
  id          Int         @id @default(autoincrement())
  tableNumber Int
  capacity    Int
  isAvailable Boolean     @default(true)
  status      TableStatus @default(AVAILABLE)
  branch      Branch      @relation(fields: [branchId], references: [id])
  branchId    Int
  bookings    Booking[]

  @@unique([tableNumber, branchId])
}

model Booking {
  id         Int           @id @default(autoincrement())
  customer   User          @relation(fields: [customerId], references: [id])
  customerId Int
  table      Table         @relation(fields: [tableId], references: [id])
  tableId    Int
  guestCount Int
  date       DateTime
  status     BookingStatus @default(PENDING)
  orders     Order[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Order {
  id         Int         @id @default(autoincrement())
  customer   User?       @relation(fields: [customerId], references: [id])
  customerId Int?
  booking    Booking?    @relation(fields: [bookingId], references: [id])
  bookingId  Int?
  branch     Branch      @relation(fields: [branchId], references: [id])
  branchId   Int
  status     OrderStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod?
  subtotal Float @default(0)
  discountTotal Float @default(0)
  deliveryFee Float @default(0)
  currency String @default("EUR")
  paymentAttemptId String?
  paymentSessionId String? @unique
  paymentCheckoutUrl String?
  paymentSessionExpiresAt DateTime?
  paidAt     DateTime?
  orderType OrderType @default(DINE_IN)
  checkoutRequestId String? @unique
  recipientName String?
  recipientPhone String?
  deliveryAddress String?
  deliveryInstructions String?
  deliveryStatus DeliveryStatus?
  assignedDriver User? @relation("AssignedDeliveryDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  assignedDriverId Int?
  assignedAt DateTime?
  pickedUpAt DateTime?
  deliveredAt DateTime?
  total      Float       @default(0)
  items      OrderItem[]
  paymentEvents PaymentEvent[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([assignedDriverId, deliveryStatus])
  @@index([branchId, orderType, deliveryStatus])
}

model PaymentEvent {
  id              Int      @id @default(autoincrement())
  providerEventId String   @unique
  eventType       String
  orderId         Int
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId Int
  quantity   Int
  unitPrice  Float
}
  